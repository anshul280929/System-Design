interface DocumentElement {
    void accept(DocumentVisitor visitor);
}
interface DocumentVisitor {
    void visit(TextElement text);
    void visit(ImageElement image);
}

class TextElement implements DocumentElement {
    private String text;

    public TextElement(String text) {
        this.text = text;
    }

    public String getText() { return text; }

    public void accept(DocumentVisitor visitor) {
        visitor.visit(this);
    }
}
class PDFExporter implements DocumentVisitor {

    private StringBuilder output = new StringBuilder();

    public void visit(TextElement text) {
        output.append("[PDF TEXT] ").append(text.getText());
    }

    public void visit(ImageElement image) {
        output.append("[PDF IMAGE]");
    }

    public String getResult() {
        return output.toString();
    }
}
class HTMLExporter implements DocumentVisitor {

    private StringBuilder output = new StringBuilder();

    public void visit(TextElement text) {
        output.append("<p>").append(text.getText()).append("</p>");
    }

    public void visit(ImageElement image) {
        output.append("<img src='image.jpg'/>");
    }

    public String getResult() {
        return output.toString();
    }
}
class Document {
    private List<DocumentElement> elements = new ArrayList<>();

    public void add(DocumentElement element) {
        elements.add(element);
    }

    public void export(DocumentVisitor visitor) {
        for (DocumentElement e : elements) {
            e.accept(visitor);
        }
    }
}
Document doc = new Document();
doc.add(new TextElement("Hello"));
doc.add(new ImageElement("img.png"));

PDFExporter pdf = new PDFExporter();
doc.export(pdf);

System.out.println(pdf.getResult());